def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "config":
        cmd_config(args)
    elif args.command == "get":
        cmd_get(args)
    elif args.command in ("list", "query", "ls"):
        cmd_list(args)
    elif args.command == "create":
        cmd_create(args)
    elif args.command == "update":
        cmd_update(args)
    elif args.command == "comment":
        cmd_comment(args)
    elif args.command == "cmdb":
        if args.cmdb_command in ("list", "ls", "query"):
            cmd_cmdb_list(args)
        elif args.cmdb_command == "get":
            cmd_cmdb_get(args)
        elif args.cmdb_command == "create":
            cmd_cmdb_create(args)
        elif args.cmdb_command == "update":
            cmd_cmdb_update(args)


if __name__ == "__main__":
    main()
