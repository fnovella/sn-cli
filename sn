def runnable_browser?(bin)
  return false if bin.nil? || bin.strip.empty?

  if Gem.win_platform?
    return true if File.file?(bin)
    return false if bin.include?("/") || bin.include?("\\")

    IO.popen(["where.exe", bin], err: File::NULL, &:read)
    return $?.success? || false
  end

  # Probe --version on POSIX to reject broken wrapper scripts (e.g. missing target binary)
  IO.popen([bin, "--version"], err: File::NULL, &:read)
  $?&.success? || false
rescue StandardError
  false
end

def find_browser_binary(preferred = nil)
  candidates = []
  candidates << preferred if preferred && !preferred.strip.empty?
  candidates << ENV["SN_BROWSER"] if ENV["SN_BROWSER"] && !ENV["SN_BROWSER"].strip.empty?

  if Gem.win_platform?
    roots = [ENV["ProgramFiles"], ENV["ProgramFiles(x86)"], ENV["LOCALAPPDATA"]].compact.reject(&:empty?)
    roots.each do |root|
      WINDOWS_BROWSER_SUBPATHS.each { |parts| candidates << File.join(root, *parts) }
    end
    candidates.concat(%w[chrome.exe msedge.exe brave.exe])
  end
  candidates.concat(BROWSER_CANDIDATES)

  candidates.uniq.find { |bin| runnable_browser?(bin) }
end

def sn_http_get(url_str, cookie_str, user_token = nil, timeout: 15)
  uri = URI.parse(url_str)
  req = Net::HTTP::Get.new(uri)
  req["User-Agent"] = "sn-cli/1.1 (ruby)"
  req["Cookie"] = cookie_str unless cookie_str.to_s.empty?
  if user_token && !user_token.empty?
    req["X-UserToken"] = user_token
    req["Accept"] = "application/json"
  end

  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = (uri.scheme == "https")
  http.open_timeout = timeout
  http.read_timeout = timeout
  http.request(req)
end

def fetch_g_ck_from_instance(instance, cookie_str)
  base = instance.sub(%r{/+\z}, "")
  instance_host = URI.parse(base).host&.downcase

  %w[/navpage.do /now/nav/ui/home].each do |path|
    url = "#{base}#{path}"
    3.times do
      resp = sn_http_get(url, cookie_str)
      code = resp.code.to_i
      if (300..399).include?(code) && resp["location"]
        loc = URI.join(url, resp["location"])
        break unless loc.host&.downcase == instance_host
        break if LOGIN_EXCLUDED_PATHS.include?(loc.path)

        url = loc.to_s
        next
      end
      if code == 200
        match = resp.body.to_s.match(G_CK_REGEX)
        return match[1] if match
      end
      break
    end
  end
  ""
rescue StandardError
  ""
end

def verify_sn_session(instance, cookie_str, user_token)
  return nil if cookie_str.to_s.strip.empty?

  base = instance.sub(%r{/+\z}, "")
  token = user_token.to_s.strip
  token = fetch_g_ck_from_instance(base, cookie_str) if token.empty?
  return nil if token.empty?

  query = URI.encode_www_form(
    "sysparm_query"  => "sys_id=javascript:gs.getUserID()",
    "sysparm_fields" => "user_name,name,email",
    "sysparm_limit"  => "1"
  )
  resp = sn_http_get("#{base}/api/now/table/sys_user?#{query}", cookie_str, token)
  return nil if resp["x-is-logged-in"].to_s.downcase == "false"
  return nil if resp.code.to_i == 401

  if resp.code.to_i == 200
    data = JSON.parse(resp.body.to_s)
    results = data["result"]
    if results.is_a?(Array) && !results.empty?
      uname = extract_raw_value(results[0]["user_name"])
      return nil if uname.downcase == "guest"

      return {
        valid:      true,
        username:   uname.empty? ? nil : uname,
        full_name:  extract_display(results[0]["name"]),
        user_token: token
      }
    end
  end

  # Fallback when sys_user read ACLs restrict access or return an empty set
  fb_query = URI.encode_www_form("sysparm_fields" => "sys_id", "sysparm_limit" => "1")
  fb_resp = sn_http_get("#{base}/api/now/table/task?#{fb_query}", cookie_str, token)
  if fb_resp.code.to_i == 200 && fb_resp["x-is-logged-in"].to_s.downcase != "false"
    return { valid: true, username: nil, user_token: token }
  end

  nil
rescue StandardError
  nil
end

def allocate_free_port
  srv = TCPServer.new("127.0.0.1", 0)
  port = srv.addr[1]
  srv.close
  port
end

def stop_browser_process(pid)
  return unless pid

  if Gem.win_platform?
    Process.kill("KILL", pid)
    Process.wait(pid)
    return
  end

  Process.kill("TERM", pid)
  20.times do
    sleep 0.1
    return if Process.wait(pid, Process::WNOHANG)
  end
  Process.kill("KILL", pid)
  Process.wait(pid)
rescue StandardError
  nil
end

def browser_page_targets(port, target_host)
  res = Net::HTTP.get_response(URI("http://127.0.0.1:#{port}/json/list"))
  return [] unless res.code == "200"

  targets = JSON.parse(res.body)
  return [] unless targets.is_a?(Array)

  targets.select do |t|
    next false unless t["type"] == "page" && !t["webSocketDebuggerUrl"].to_s.empty?

    begin
      u = URI.parse(t["url"].to_s)
      u.host&.downcase == target_host && !LOGIN_EXCLUDED_PATHS.include?(u.path)
    rescue StandardError
      false
    end
  end
rescue StandardError
  []
end

def extract_page_session_info(ws_url, instance)
  cdp = CdpClient.new(ws_url)
  js = <<~'JS'
    (() => {
      if (document.readyState === 'loading') return { ready: false };
      const g_ck = window.g_ck ||
                   (window.NOW && (window.NOW.g_ck || (window.NOW.session && window.NOW.session.g_ck))) ||
                   (document.getElementById('sysparm_ck') && document.getElementById('sysparm_ck').value) ||
                   ((document.documentElement && document.documentElement.innerHTML.match(/(?:var\s+g_ck|["']?g_ck["']?)\s*[:=]\s*["']([0-9a-fA-F]{32,})["']/)) || [])[1] ||
                   '';
      const user = (window.NOW && (window.NOW.user_name || (window.NOW.user && window.NOW.user.name))) || '';
      return { ready: true, g_ck: g_ck, user: user, path: location.pathname };
    })()
  JS
  eval_res = cdp.call("Runtime.evaluate", { "expression" => js, "returnByValue" => true })
  info = eval_res.dig("result", "value")
  return nil unless info.is_a?(Hash) && info["ready"]
  return nil if info["user"].to_s.downcase == "guest"

  cookie_res = cdp.call("Network.getCookies", { "urls" => [instance] })
  cookies = cookie_res["cookies"] || []
  return nil if cookies.empty?

  names = cookies.map { |c| c["name"] }
  has_session = names.any? { |n| %w[JSESSIONID glide_user_activity glide_session_store].include?(n) }
  return nil unless has_session
  return nil if info["g_ck"].to_s.empty? && !(names.include?("glide_user_activity") || names.include?("glide_session_store"))

  cookie_str = cookies.map { |c| "#{c['name']}=#{c['value']}" }.join("; ")
  { cookie_str: cookie_str, g_ck: info["g_ck"].to_s, js_user: info["user"].to_s }
rescue StandardError
  nil
ensure
  cdp&.close
end

def perform_browser_login(instance, profile: "default", browser: nil, timeout: 300, fresh: false)
  browser_bin = find_browser_binary(browser)
  if browser_bin.nil?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} No working Chromium-based browser found (#{BROWSER_CANDIDATES.join(', ')})."
    $stderr.puts "Install Chromium or pass --browser /path/to/browser (or set SN_BROWSER)."
    exit 1
  end

  target_host = URI.parse(instance).host&.downcase
  if target_host.nil? || target_host.empty?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Invalid ServiceNow instance URL '#{instance}'."
    exit 1
  end

  user_data_dir = File.join(BROWSER_PROFILE_DIR, profile)
  FileUtils.rm_rf(user_data_dir) if fresh
  FileUtils.mkdir_p(BROWSER_PROFILE_DIR, mode: 0o700)
  FileUtils.mkdir_p(user_data_dir, mode: 0o700)
  File.chmod(0o700, BROWSER_PROFILE_DIR, user_data_dir)

  port = allocate_free_port
  cmd = [
    browser_bin,
    "--remote-debugging-port=#{port}",
    "--user-data-dir=#{user_data_dir}",
    "--no-first-run",
    "--no-default-browser-check",
    "--new-window",
    "--app=#{instance.sub(%r{/+\z}, '')}/navpage.do"
  ]

  puts "#{Colors::CYAN}Opening #{browser_bin} for SSO/MFA login at #{Colors::BOLD}#{instance}#{Colors::RESET}#{Colors::CYAN}...#{Colors::RESET}"
  puts "#{Colors::DIM}Complete authentication (Entra ID / MFA) in the browser window. It will close automatically once verified.#{Colors::RESET}"

  pid = Process.spawn(*cmd, out: File::NULL, err: File::NULL)
  deadline = Time.now + (timeout || 300)

  begin
    loop do
      reaped = begin
        Process.wait(pid, Process::WNOHANG)
      rescue Errno::ECHILD
        pid
      end
      if reaped
        pid = nil
        $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Browser window was closed before login completed."
        exit 1
      end

      if Time.now > deadline
        $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Timed out waiting for SSO/MFA login (#{timeout}s)."
        exit 1
      end

      browser_page_targets(port, target_host).each do |target|
        page_info = extract_page_session_info(target["webSocketDebuggerUrl"], instance)
        next unless page_info

        verified = verify_sn_session(instance, page_info[:cookie_str], page_info[:g_ck])
        next unless verified

        detected_user = verified[:username] || (page_info[:js_user].downcase == "guest" ? nil : page_info[:js_user])
        return {
          "cookie"     => page_info[:cookie_str],
          "user_token" => verified[:user_token].to_s,
          "username"   => detected_user.to_s,
          "full_name"  => verified[:full_name].to_s
        }
      end

      sleep 0.6
    end
  rescue Interrupt
    $stderr.puts "\n#{Colors::YELLOW}Login cancelled.#{Colors::RESET}"
    exit 130
  ensure
    stop_browser_process(pid)
  end
end

