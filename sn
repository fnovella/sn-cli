def colorize_parser_help(help_str)
  return help_str unless Colors::ENABLED

  c = Colors
  help_str.lines.map do |line|
    if line.start_with?("usage:")
      line
        .sub(/\Ausage:\s+(sn(?:\s+\S+)?)/, "#{c::BOLD}#{c::YELLOW}usage:#{c::RESET} #{c::BOLD}#{c::CYAN}\\1#{c::RESET}")
        .gsub(/(\[-[^\]]+\])/) do |m|
          m.gsub(/(-\w|--[\w-]+)/, "#{c::GREEN}\\1#{c::RESET}")
           .gsub(/\b([A-Z_]{2,}|\{[^}]+\})\b/, "#{c::CYAN}\\1#{c::RESET}")
        end
    elsif line.chomp =~ /\A(\s*)(-\w(?:,\s*--[\w-]+)?|--[\w-]+)(\s+[A-Z_=]+|\s+\{[^}]+\})?(\s{2,})(.*)\z/
      indent = Regexp.last_match(1)
      flags = Regexp.last_match(2)
      metavar = Regexp.last_match(3).to_s
      gap = Regexp.last_match(4)
      desc = Regexp.last_match(5)

      colored_flags = flags.gsub(/(-\w|--[\w-]+)/, "#{c::BOLD}#{c::GREEN}\\1#{c::RESET}")
      colored_meta = metavar.empty? ? "" : "#{c::CYAN}#{metavar}#{c::RESET}"
      colored_desc = desc.gsub(/(\((?:default|e\.g\.)[^)]*\))/, "#{c::DIM}\\1#{c::RESET}")
      "#{indent}#{colored_flags}#{colored_meta}#{gap}#{colored_desc}\n"
    else
      line
    end
  end.join
end

def add_common_ci_mutation_opts(opts, options)
  opts.on("--ip IP", "IP address") { |v| options[:ip] = v }
  opts.on("--serial SERIAL", "Serial number") { |v| options[:serial] = v }
  opts.on("--asset-tag TAG", "Asset tag") { |v| options[:asset_tag] = v }
  opts.on("--os OS", "Operating system") { |v| options[:os] = v }
  opts.on("--ram RAM", "RAM in MB") { |v| options[:ram] = v }
  opts.on("--cpu-count COUNT", "Number of CPUs") { |v| options[:cpu_count] = v }
  opts.on("--location LOC", "Location name or sys_id") { |v| options[:location] = v }
  opts.on("-a", "--assigned-to USER", "Assigned user") { |v| options[:assigned_to] = v }
  opts.on("-g", "--group GROUP", "Support group") { |v| options[:group] = v }
  opts.on("--status STATUS", "Operational status (e.g. 1=Operational, 2=Non-Operational)") { |v| options[:status] = v }
  opts.on("-D", "--desc DESC", "Short description") { |v| options[:desc] = v }
  opts.on("-S", "--set KEY=VAL", "Set arbitrary field (repeatable)") { |v| (options[:set] ||= []) << v }
  opts.on("-d", "--data JSON", "Raw JSON object string to merge into payload") { |v| options[:data] = v }
  opts.on("--json", "Output raw JSON") { options[:json] = true }
end

def add_profile_opt(opts, options)
  opts.on("-p", "--profile PROFILE", "Config profile name (default: 'default')") { |v| options[:profile] = v }
  opts.on_tail("-h", "--help", "Show this help message and exit") do
    puts colorize_parser_help(opts.help)
    exit 0
  end
end

def extract_leading_global_flags(argv, options)
  rest = argv.dup
  while !rest.empty?
    case rest[0]
    when "-p", "--profile"
      if rest.length < 2
        $stderr.puts "Error: #{rest[0]} requires a profile name."
        exit 1
      end
      rest.shift
      options[:profile] = rest.shift
    when /\A--profile=(.+)\z/
      options[:profile] = Regexp.last_match(1)
      rest.shift
    when "-h", "--help"
      puts main_help
      exit 0
    else
      break
    end
  end
  rest
end

def parse_with_errors(parser, args)
  parser.parse!(args)
rescue OptionParser::ParseError => e
  $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} #{e.message}"
  $stderr.puts colorize_parser_help(parser.help)
  exit 1
end

def main
  options = { profile: "default", set: [] }
  args = extract_leading_global_flags(ARGV, options)

  if args.empty?
    puts main_help
    exit 1
  end

  if args[0] == "help"
    args.shift
    if args.empty?
      puts main_help
      exit 0
    end
    args << "--help"
  end

  command = args.shift

  case command
  when "config"
    parser = OptionParser.new do |opts|
      opts.banner = "usage: sn config [-h] [-p PROFILE]"
      add_profile_opt(opts, options)
    end
    parse_with_errors(parser, args)
    cmd_config(options)

  when "get"
    parser = OptionParser.new do |opts|
      opts.banner = "usage: sn get [-h] [-t TABLE] [-c] [--json] ticket"
      add_profile_opt(opts, options)
      opts.on("-t", "--table TABLE", "Override table name (auto-detected from prefix by default)") { |v| options[:table] = v }
      opts.on("-c", "--comments", "Include comments and work notes") { options[:comments] = true }
      opts.on("--json", "Output raw JSON") { options[:json] = true }
    end
    parse_with_errors(parser, args)
    if args.empty?
      $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} the following arguments are required: ticket"
      $stderr.puts colorize_parser_help(parser.help)
      exit 1
    end
    options[:ticket] = args.shift
    cmd_get(options)

  when "list", "query", "ls"
    options[:table] = "task"
    options[:limit] = 25
    options[:sort] = "sys_updated_on"
    options[:output] = "table"

    parser = OptionParser.new do |opts|
      opts.banner = "usage: sn #{command} [-h] [-t TABLE] [-m] [--caller CALLER] [-g GROUP] [--state STATE] [--priority PRIORITY] [-s SEARCH] [-q QUERY] [-a] [-f FIELDS] [-l LIMIT] [--sort SORT] [-o {table,json,csv,tsv}]"
      add_profile_opt(opts, options)
      opts.on("-t", "--table TABLE", "Table to query (default: task, e.g. incident, sc_req_item)") { |v| options[:table] = v }
      opts.on("-m", "--mine", "Only tickets assigned to me") { options[:mine] = true }
      opts.on("--caller CALLER", "Filter by caller / opened_by username") { |v| options[:caller] = v }
      opts.on("-g", "--group GROUP", "Filter by assignment group name (contains)") { |v| options[:group] = v }
      opts.on("--state STATE", "Filter by state value") { |v| options[:state] = v }
      opts.on("--priority PRIORITY", "Filter by priority (e.g. 1, 2, 3)") { |v| options[:priority] = v }
      opts.on("-s", "--search SEARCH", "Search text in short_description or description") { |v| options[:search] = v }
      opts.on("-q", "--query QUERY", "Raw ServiceNow sysparm_query string") { |v| options[:query] = v }
      opts.on("-a", "--all", "Include closed/inactive tickets") { options[:all] = true }
      opts.on("-f", "--fields FIELDS", "Comma-separated fields (default: #{DEFAULT_TICKET_FIELDS.join(',')})") { |v| options[:fields] = v }
      opts.on("-l", "--limit LIMIT", Integer, "Max records to return (default: 25)") { |v| options[:limit] = v }
      opts.on("--sort SORT", "Field to sort descending by (default: sys_updated_on)") { |v| options[:sort] = v }
      opts.on("-o", "--output FORMAT", %w[table json csv tsv], "Output format (table, json, csv, tsv)") { |v| options[:output] = v }
    end
    parse_with_errors(parser, args)
    cmd_list(options)

  when "create"
    options[:table] = "incident"

    parser = OptionParser.new do |opts|
      opts.banner = "usage: sn create [-h] [-t TABLE] [--title TITLE] [-D DESC] [--urgency URGENCY] [--impact IMPACT] [--priority PRIORITY] [-g GROUP] [-a ASSIGNED_TO] [--caller CALLER] [--ci CI] [--category CATEGORY] [--subcategory SUBCATEGORY] [-S KEY=VAL] [-d DATA] [--json] [short_description]"
      add_profile_opt(opts, options)
      opts.on("-t", "--table TABLE", "Table name (default: incident, e.g. change_request, problem)") { |v| options[:table] = v }
      opts.on("--title TITLE", "Short description (alternative to positional argument)") { |v| options[:title] = v }
      opts.on("-D", "--desc DESC", "Detailed description") { |v| options[:desc] = v }
      opts.on("--urgency URGENCY", "Urgency (1=High, 2=Medium, 3=Low)") { |v| options[:urgency] = v }
      opts.on("--impact IMPACT", "Impact (1=High, 2=Medium, 3=Low)") { |v| options[:impact] = v }
      opts.on("--priority PRIORITY", "Priority (normally calculated from impact + urgency)") { |v| options[:priority] = v }
      opts.on("-g", "--group GROUP", "Assignment group name or sys_id") { |v| options[:group] = v }
      opts.on("-a", "--assigned-to USER", "Assigned user") { |v| options[:assigned_to] = v }
      opts.on("--caller CALLER", "Caller username or sys_id") { |v| options[:caller] = v }
      opts.on("--ci CI", "CMDB Configuration Item (cmdb_ci) name or sys_id") { |v| options[:ci] = v }
      opts.on("--category CATEGORY", "Category") { |v| options[:category] = v }
      opts.on("--subcategory SUBCATEGORY", "Subcategory") { |v| options[:subcategory] = v }
      opts.on("-S", "--set KEY=VAL", "Set any custom field (repeatable)") { |v| (options[:set] ||= []) << v }
      opts.on("-d", "--data JSON", "Raw JSON object string to merge into payload") { |v| options[:data] = v }
      opts.on("--json", "Output raw JSON") { options[:json] = true }
    end
    parse_with_errors(parser, args)
    options[:short_description] = args.shift unless args.empty?
    cmd_create(options)

  when "update"
    parser = OptionParser.new do |opts|
      opts.banner = "usage: sn update [-h] [-t TABLE] [--state STATE] [--title TITLE] [-D DESC] [--urgency URGENCY] [--impact IMPACT] [--priority PRIORITY] [-g GROUP] [-a ASSIGNED_TO] [--ci CI] [-c COMMENT] [-w WORK_NOTE] [--close-code CLOSE_CODE] [--close-notes CLOSE_NOTES] [-S KEY=VAL] [-d DATA] [--json] ticket"
      add_profile_opt(opts, options)
      opts.on("-t", "--table TABLE", "Override table name") { |v| options[:table] = v }
      opts.on("--state STATE", "New state (e.g. 'In Progress', 'Resolved', or numeric code)") { |v| options[:state] = v }
      opts.on("--title TITLE", "Update short_description") { |v| options[:title] = v }
      opts.on("-D", "--desc DESC", "Update description") { |v| options[:desc] = v }
      opts.on("--urgency URGENCY", "Update urgency (1, 2, 3)") { |v| options[:urgency] = v }
      opts.on("--impact IMPACT", "Update impact (1, 2, 3)") { |v| options[:impact] = v }
      opts.on("--priority PRIORITY", "Update priority") { |v| options[:priority] = v }
      opts.on("-g", "--group GROUP", "Update assignment group") { |v| options[:group] = v }
      opts.on("-a", "--assigned-to USER", "Update assigned_to user") { |v| options[:assigned_to] = v }
      opts.on("--ci CI", "Update CMDB Configuration Item (cmdb_ci)") { |v| options[:ci] = v }
      opts.on("-c", "--comment COMMENT", "Add customer-visible comment") { |v| options[:comment] = v }
      opts.on("-w", "--work-note WORK_NOTE", "Add internal work note") { |v| options[:work_note] = v }
      opts.on("--close-code CODE", "Resolution code (when resolving/closing)") { |v| options[:close_code] = v }
      opts.on("--close-notes NOTES", "Resolution notes (when resolving/closing)") { |v| options[:close_notes] = v }
      opts.on("-S", "--set KEY=VAL", "Set any custom field (repeatable)") { |v| (options[:set] ||= []) << v }
      opts.on("-d", "--data JSON", "Raw JSON object string to merge into payload") { |v| options[:data] = v }
      opts.on("--json", "Output raw JSON") { options[:json] = true }
    end
    parse_with_errors(parser, args)
    if args.empty?
      $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} the following arguments are required: ticket"
      $stderr.puts colorize_parser_help(parser.help)
      exit 1
    end
    options[:ticket] = args.shift
    cmd_update(options)

  when "comment"
    parser = OptionParser.new do |opts|
      opts.banner = "usage: sn comment [-h] [-w] [-t TABLE] ticket message"
      add_profile_opt(opts, options)
      opts.on("-w", "--work-note", "Post as internal work_notes instead of customer-visible comments") { options[:work_note] = true }
      opts.on("-t", "--table TABLE", "Override table name") { |v| options[:table] = v }
    end
    parse_with_errors(parser, args)
    if args.length < 2
      $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} the following arguments are required: ticket, message"
      $stderr.puts colorize_parser_help(parser.help)
      exit 1
    end
    options[:ticket] = args.shift
    options[:message] = args.shift
    cmd_comment(options)

  when "cmdb"
    if args.empty? || %w[-h --help].include?(args[0])
      puts cmdb_help
      exit(args.empty? ? 1 : 0)
    end
    if args[0] == "help"
      args.shift
      if args.empty? || %w[-h --help].include?(args[0])
        puts cmdb_help
        exit 0
      end
      args << "--help"
    end
    cmdb_cmd = args.shift

    case cmdb_cmd
    when "list", "ls", "query"
      options[:ci_class] = "cmdb_ci"
      options[:limit] = 25
      options[:output] = "table"

      parser = OptionParser.new do |opts|
        opts.banner = "usage: sn cmdb #{cmdb_cmd} [-h] [-c CI_CLASS] [-s SEARCH] [--ip IP] [--serial SERIAL] [--os OS] [--status STATUS] [-q QUERY] [-f FIELDS] [-l LIMIT] [-o {table,json,csv,tsv}]"
        add_profile_opt(opts, options)
        opts.on("-c", "--class CI_CLASS", "CI class table or alias (e.g. server, linux, win, computer, vm, netgear, app, service; default: cmdb_ci)") { |v| options[:ci_class] = v }
        opts.on("-s", "--search SEARCH", "Search across name, IP, serial number, and asset tag") { |v| options[:search] = v }
        opts.on("--ip IP", "Filter by IP address") { |v| options[:ip] = v }
        opts.on("--serial SERIAL", "Filter by exact serial number") { |v| options[:serial] = v }
        opts.on("--os OS", "Filter by Operating System") { |v| options[:os] = v }
        opts.on("--status STATUS", "Filter by operational_status") { |v| options[:status] = v }
        opts.on("-q", "--query QUERY", "Raw ServiceNow sysparm_query") { |v| options[:query] = v }
        opts.on("-f", "--fields FIELDS", "Comma-separated fields (default: #{DEFAULT_CMDB_FIELDS.join(',')})") { |v| options[:fields] = v }
        opts.on("-l", "--limit LIMIT", Integer, "Max records (default: 25)") { |v| options[:limit] = v }
        opts.on("-o", "--output FORMAT", %w[table json csv tsv], "Output format (table, json, csv, tsv)") { |v| options[:output] = v }
      end
      parse_with_errors(parser, args)
      cmd_cmdb_list(options)

    when "get"
      options[:ci_class] = "cmdb_ci"

      parser = OptionParser.new do |opts|
        opts.banner = "usage: sn cmdb get [-h] [-c CI_CLASS] [-r] [--json] identifier"
        add_profile_opt(opts, options)
        opts.on("-c", "--class CI_CLASS", "CI class table or alias") { |v| options[:ci_class] = v }
        opts.on("-r", "--relationships", "Include upstream/downstream CI relationships") { options[:relationships] = true }
        opts.on("--json", "Output raw JSON") { options[:json] = true }
      end
      parse_with_errors(parser, args)
      if args.empty?
        $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} the following arguments are required: identifier"
        $stderr.puts colorize_parser_help(parser.help)
        exit 1
      end
      options[:identifier] = args.shift
      cmd_cmdb_get(options)

    when "create"
      options[:ci_class] = "cmdb_ci_server"
      options[:source] = "Manual Entry"

      parser = OptionParser.new do |opts|
        opts.banner = "usage: sn cmdb create [-h] [-c CI_CLASS] [--ire] [--source SOURCE] [options] [name]"
        add_profile_opt(opts, options)
        opts.on("-c", "--class CI_CLASS", "CI class table or alias (default: cmdb_ci_server; e.g. linux, win, computer, vm, app)") { |v| options[:ci_class] = v }
        opts.on("--ire", "Use CMDB Instance / IRE API (/api/now/cmdb/instance) for duplicate prevention & reconciliation") { options[:ire] = true }
        opts.on("--source SOURCE", "Discovery source when using --ire (default: 'Manual Entry')") { |v| options[:source] = v }
        add_common_ci_mutation_opts(opts, options)
      end
      parse_with_errors(parser, args)
      options[:name] = args.shift unless args.empty?
      cmd_cmdb_create(options)

    when "update"
      options[:ci_class] = "cmdb_ci"

      parser = OptionParser.new do |opts|
        opts.banner = "usage: sn cmdb update [-h] [-c CI_CLASS] [--new-name NEW_NAME] [options] identifier"
        add_profile_opt(opts, options)
        opts.on("-c", "--class CI_CLASS", "CI class table or alias") { |v| options[:ci_class] = v }
        opts.on("--new-name NEW_NAME", "Rename the CI") { |v| options[:new_name] = v }
        add_common_ci_mutation_opts(opts, options)
      end
      parse_with_errors(parser, args)
      if args.empty?
        $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} the following arguments are required: identifier"
        $stderr.puts colorize_parser_help(parser.help)
        exit 1
      end
      options[:identifier] = args.shift
      cmd_cmdb_update(options)

    else
      $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Unknown cmdb subcommand '#{cmdb_cmd}'."
      $stderr.puts cmdb_help
      exit 1
    end

  else
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Unknown command '#{command}'."
    $stderr.puts main_help
    exit 1
  end
end

main if __FILE__ == $PROGRAM_NAME
