    print(f"{Colors.BOLD}Operational Status:{Colors.RESET} {op_status}")
    print(f"{Colors.BOLD}Install Status:{Colors.RESET}     {inst_status}")
    if ip:
        print(f"{Colors.BOLD}IP Address:{Colors.RESET}         {ip}")
    if serial:
