#!/usr/bin/env ruby
# frozen_string_literal: true

# sn - Standalone ServiceNow CLI for querying, creating, and updating tickets and CMDB items.
# Zero external dependencies (uses Ruby standard library only).

require "fileutils"
require "io/console"
require "json"
require "net/http"
require "optparse"
require "uri"

begin
  require "csv"
rescue LoadError
  # Fallback if csv gem is not installed in minimal Ruby environments
end

CONFIG_PATH = File.join(Dir.home, ".config", "servicenow", "config.json")

PREFIX_TABLE_MAP = {
  "INC"    => "incident",
  "RITM"   => "sc_req_item",
  "REQ"    => "sc_request",
  "SCTASK" => "sc_task",
  "CHG"    => "change_request",
  "CTASK"  => "change_task",
  "PRB"    => "problem",
  "PTASK"  => "problem_task",
  "KB"     => "kb_knowledge",
  "TASK"   => "task"
}.freeze

CMDB_CLASS_ALIASES = {
  "ci"       => "cmdb_ci",
  "server"   => "cmdb_ci_server",
  "linux"    => "cmdb_ci_linux_server",
  "win"      => "cmdb_ci_win_server",
  "windows"  => "cmdb_ci_win_server",
  "computer" => "cmdb_ci_computer",
  "pc"       => "cmdb_ci_pc_hardware",
  "vm"       => "cmdb_ci_vm_instance",
  "netgear"  => "cmdb_ci_netgear",
  "switch"   => "cmdb_ci_ip_switch",
  "router"   => "cmdb_ci_ip_router",
  "firewall" => "cmdb_ci_ip_firewall",
  "app"      => "cmdb_ci_appl",
  "service"  => "cmdb_ci_service",
  "db"       => "cmdb_ci_database"
}.freeze

DEFAULT_TICKET_FIELDS = %w[
  number
  sys_class_name
  state
  priority
  assigned_to
  assignment_group
  sys_updated_on
  short_description
].freeze

DEFAULT_CMDB_FIELDS = %w[
  name
  sys_class_name
  ip_address
  serial_number
  operational_status
  assigned_to
  sys_updated_on
].freeze

module Colors
  ENABLED = $stdout.tty? && ENV["NO_COLOR"].nil?
  BOLD    = ENABLED ? "\e[1m"  : ""
  DIM     = ENABLED ? "\e[2m"  : ""
  CYAN    = ENABLED ? "\e[36m" : ""
  GREEN   = ENABLED ? "\e[32m" : ""
  YELLOW  = ENABLED ? "\e[33m" : ""
  BLUE    = ENABLED ? "\e[34m" : ""
  MAGENTA = ENABLED ? "\e[35m" : ""
  RED     = ENABLED ? "\e[31m" : ""
  RESET   = ENABLED ? "\e[0m"  : ""
end

def normalize_instance_url(instance)
  inst = instance.to_s.strip.sub(%r{/+\z}, "")
  return "" if inst.empty?

  unless inst.start_with?("http://", "https://")
    inst = inst.include?(".") ? "https://#{inst}" : "https://#{inst}.service-now.com"
  end
  inst
end

def resolve_cmdb_class(cls_name, default: "cmdb_ci")
  return default if cls_name.nil? || cls_name.strip.empty?

  key = cls_name.strip.downcase
  CMDB_CLASS_ALIASES.fetch(key, cls_name.strip)
end

def sys_id?(ident)
  ident.is_a?(String) && ident.match?(/\A[0-9a-fA-F]{32}\z/)
end

def indent_text(text, prefix = "  ")
  text.to_s.lines.map { |line| line.strip.empty? ? "\n" : "#{prefix}#{line}" }.join
end

def parse_kv_and_json(set_list, json_str)
  payload = {}
  if json_str && !json_str.empty?
    begin
      parsed = JSON.parse(json_str)
      raise "JSON payload must be an object/dictionary" unless parsed.is_a?(Hash)

      payload.merge!(parsed)
    rescue StandardError => e
      $stderr.puts "#{Colors::RED}Invalid --data JSON:#{Colors::RESET} #{e.message}"
      exit 1
    end
  end

  Array(set_list).each do |item|
    unless item.include?("=")
      $stderr.puts "#{Colors::RED}Invalid --set argument '#{item}':#{Colors::RESET} Expected KEY=VALUE format."
      exit 1
    end
    k, v = item.split("=", 2)
    payload[k.strip] = v
  end
  payload
end

def load_config(profile = "default")
  cfg = {}
  if File.exist?(CONFIG_PATH)
    begin
      data = JSON.parse(File.read(CONFIG_PATH, encoding: "utf-8"))
      profiles = data["profiles"] || {}
      active = profile != "default" ? profile : (data["default_profile"] || "default")
      cfg = (profiles[active] || {}).dup
    rescue StandardError => e
      $stderr.puts "Warning: could not read #{CONFIG_PATH}: #{e.message}"
    end
  end

  # Environment variable overrides
  cfg["instance"] = normalize_instance_url(ENV["SN_INSTANCE"]) if ENV["SN_INSTANCE"] && !ENV["SN_INSTANCE"].empty?
  cfg["username"] = ENV["SN_USER"] if ENV["SN_USER"] && !ENV["SN_USER"].empty?
  if ENV["SN_PASS"] && !ENV["SN_PASS"].empty?
    cfg["password"] = ENV["SN_PASS"]
    cfg["auth_type"] ||= "basic"
  end
  if ENV["SN_TOKEN"] && !ENV["SN_TOKEN"].empty?
    cfg["token"] = ENV["SN_TOKEN"]
    cfg["auth_type"] = "token"
  end

  cfg
end

def save_config(profile, profile_data)
  FileUtils.mkdir_p(File.dirname(CONFIG_PATH))
  data = { "default_profile" => profile, "profiles" => {} }
  if File.exist?(CONFIG_PATH)
    begin
      data = JSON.parse(File.read(CONFIG_PATH, encoding: "utf-8"))
    rescue StandardError
      # Ignore malformed existing file
    end
  end
  data["profiles"] ||= {}
  data["profiles"][profile] = profile_data
  data["default_profile"] = profile

  File.write(CONFIG_PATH, "#{JSON.pretty_generate(data)}\n", encoding: "utf-8")
  File.chmod(0o600, CONFIG_PATH)
end

def detect_table(identifier, explicit_table = nil)
  return explicit_table if explicit_table && !explicit_table.empty?

  upper = identifier.to_s.upcase
  PREFIX_TABLE_MAP.keys.sort_by { |k| -k.length }.each do |prefix|
    return PREFIX_TABLE_MAP[prefix] if upper.start_with?(prefix)
  end
  "task"
end

def extract_display(val)
  return "" if val.nil?

  if val.is_a?(Hash)
    res = val["display_value"]
    res = val["value"] if res.nil? || res.to_s.empty?
    return res.to_s
  end
  val.to_s
end

def extract_raw_value(val)
  return "" if val.nil?

  if val.is_a?(Hash)
    res = val["value"]
    res = val["display_value"] if res.nil? || res.to_s.empty?
    return res.to_s
  end
  val.to_s
end

def sn_request(cfg, method, path, params: nil, body: nil)
  instance = cfg["instance"]
  if instance.nil? || instance.empty?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} ServiceNow instance not configured."
    $stderr.puts "Run '#{Colors::BOLD}sn config#{Colors::RESET}' or set SN_INSTANCE, SN_USER, SN_PASS."
    exit 1
  end

  url_str = "#{instance.sub(%r{/+\z}, '')}/#{path.sub(%r{\A/+}, '')}"
  if params && !params.empty?
    query_string = URI.encode_www_form(params)
    url_str = "#{url_str}?#{query_string}"
  end

  uri = URI.parse(url_str)
  req_class = case method.to_s.upcase
              when "GET"    then Net::HTTP::Get
              when "POST"   then Net::HTTP::Post
              when "PATCH"  then Net::HTTP::Patch
              when "PUT"    then Net::HTTP::Put
              when "DELETE" then Net::HTTP::Delete
              else raise ArgumentError, "Unsupported HTTP method: #{method}"
              end

  req = req_class.new(uri)
  req["Accept"] = "application/json"
  req["Content-Type"] = "application/json"
  req["User-Agent"] = "sn-cli/1.1 (ruby)"

  auth_type = cfg.fetch("auth_type", "basic")
  if auth_type == "token" && cfg["token"] && !cfg["token"].empty?
    req["Authorization"] = "Bearer #{cfg['token']}"
  elsif auth_type == "cookie" && cfg["cookie"] && !cfg["cookie"].empty?
    req["Cookie"] = cfg["cookie"]
    req["X-UserToken"] = cfg["user_token"] if cfg["user_token"] && !cfg["user_token"].empty?
  else
    user = cfg["username"].to_s
    pw = cfg["password"].to_s
    if user.empty? || pw.empty?
      $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Missing credentials. Run '#{Colors::BOLD}sn config#{Colors::RESET}'."
      exit 1
    end
    b64 = ["#{user}:#{pw}"].pack("m0")
    req["Authorization"] = "Basic #{b64}"
  end

  req.body = JSON.generate(body) unless body.nil?

  begin
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == "https")
    http.open_timeout = 30
    http.read_timeout = 30

    resp = http.request(req)
    code = resp.code.to_i
    raw = resp.body.to_s

    if code >= 200 && code < 300
      return raw.empty? ? {} : JSON.parse(raw)
    else
      begin
        err_json = JSON.parse(raw)
        err_obj = err_json["error"].is_a?(Hash) ? err_json["error"] : {}
        msg = err_obj["message"] || raw
        detail = err_obj["detail"].to_s
      rescue StandardError
        msg = raw
        detail = ""
      end
      $stderr.puts "#{Colors::RED}HTTP #{code} Error:#{Colors::RESET} #{msg}"
      $stderr.puts "Detail: #{detail}" unless detail.empty?
      exit 1
    end
  rescue StandardError => e
    $stderr.puts "#{Colors::RED}Connection Error:#{Colors::RESET} #{e.message}"
    exit 1
  end
end

def format_delimited_row(values, delimiter)
  if defined?(CSV)
    CSV.generate_line(values, col_sep: delimiter)
  else
    values.map do |v|
      s = v.to_s
      if s.include?(delimiter) || s.include?('"') || s.include?("\n") || s.include?("\r")
        "\"#{s.gsub('"', '""')}\""
      else
        s
      end
    end.join(delimiter) + "\n"
  end
end

def print_table(rows, fields, empty_msg: "No matching records found.")
  if rows.nil? || rows.empty?
    puts empty_msg
    return
  end

  headers = fields.map(&:upcase)
  matrix = rows.map do |r|
    fields.map do |f|
      val = extract_display(r[f]).gsub("\n", " ").delete("\r")
      val = "#{val[0, 62]}..." if %w[short_description description].include?(f) && val.length > 65
      val
    end
  end

  widths = headers.map(&:length)
  matrix.each do |row|
    row.each_with_index do |cell, i|
      widths[i] = [widths[i], cell.length].max
    end
  end

  header_line = headers.each_with_index.map { |h, i| h.ljust(widths[i]) }.join("  ")
  sep_line = widths.map { |w| "-" * w }.join("  ")
  puts "#{Colors::BOLD}#{Colors::CYAN}#{header_line}#{Colors::RESET}"
  puts "#{Colors::DIM}#{sep_line}#{Colors::RESET}"

  matrix.each do |row|
    formatted_cells = row.each_with_index.map do |cell, i|
      padded = cell.ljust(widths[i])
      if %w[number name].include?(fields[i])
        "#{Colors::BOLD}#{padded}#{Colors::RESET}"
      elsif fields[i] == "priority"
        if cell.start_with?("1") || cell.include?("Critical")
          "#{Colors::RED}#{padded}#{Colors::RESET}"
        elsif cell.start_with?("2") || cell.include?("High")
          "#{Colors::YELLOW}#{padded}#{Colors::RESET}"
        else
          padded
        end
      else
        padded
      end
    end
    puts formatted_cells.join("  ")
  end
end

def resolve_ticket_sys_id(cfg, ident, table)
  return ident if sys_id?(ident)

  params = {
    "sysparm_query"  => "number=#{ident.upcase}",
    "sysparm_fields" => "sys_id,number",
    "sysparm_limit"  => "1"
  }
  res = sn_request(cfg, "GET", "/api/now/table/#{table}", params: params)
  results = res["result"] || []
  if results.empty? && table != "task"
    res = sn_request(cfg, "GET", "/api/now/table/task", params: params)
    results = res["result"] || []
  end
  if results.empty?
    $stderr.puts "#{Colors::RED}Ticket '#{ident}' not found.#{Colors::RESET}"
    exit 1
  end
  extract_raw_value(results[0]["sys_id"])
end

def prompt_input(prompt_text)
  $stdout.print(prompt_text)
  $stdout.flush
  ($stdin.gets || "").strip
end

def prompt_secret(prompt_text)
  $stdout.print(prompt_text)
  $stdout.flush
  val = if $stdin.tty?
          $stdin.noecho(&:gets)
        else
          $stdin.gets
        end
  puts
  (val || "").strip
end

