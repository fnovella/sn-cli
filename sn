def resolve_ci_record(cfg, ident, ci_class)
  query = if sys_id?(ident)
            "sys_id=#{ident}"
          else
            "name=#{ident}^ORserial_number=#{ident}^ORip_address=#{ident}^ORasset_tag=#{ident}"
          end

  params = {
    "sysparm_query"         => query,
    "sysparm_display_value" => "all",
    "sysparm_limit"         => "1"
  }
  res = sn_request(cfg, "GET", "/api/now/table/#{ci_class}", params: params)
  results = res["result"] || []
  if results.empty? && ci_class != "cmdb_ci"
    res = sn_request(cfg, "GET", "/api/now/table/cmdb_ci", params: params)
    results = res["result"] || []
  end
  if results.empty?
    $stderr.puts "#{Colors::RED}CMDB CI '#{ident}' not found.#{Colors::RESET}"
    exit 1
  end
  results[0]
end

def cmd_cmdb_list(options)
  cfg = load_config(options[:profile])
  ci_class = resolve_cmdb_class(options[:ci_class], default: "cmdb_ci")

  query_parts = []
  if options[:search]
    s = options[:search]
    query_parts << "nameLIKE#{s}^ORip_addressLIKE#{s}^ORserial_numberLIKE#{s}^ORasset_tagLIKE#{s}"
  end
  query_parts << "ip_addressLIKE#{options[:ip]}" if options[:ip]
  query_parts << "serial_number=#{options[:serial]}" if options[:serial]
  query_parts << "osLIKE#{options[:os]}" if options[:os]
  query_parts << "operational_status=#{options[:status]}" if options[:status]
  query_parts << options[:query] if options[:query] && !options[:query].empty?

  query_parts << "ORDERBYDESCsys_updated_on"
  final_query = query_parts.join("^")

  fields = if options[:fields] && !options[:fields].empty?
             options[:fields].split(",").map(&:strip).reject(&:empty?)
           else
             DEFAULT_CMDB_FIELDS
           end

  params = {
    "sysparm_query"         => final_query,
    "sysparm_fields"        => fields.join(","),
    "sysparm_display_value" => "true",
    "sysparm_limit"         => (options[:limit] || 25).to_s
  }

  res = sn_request(cfg, "GET", "/api/now/table/#{ci_class}", params: params)
  records = res["result"] || []

  case options[:output]
  when "json"
    puts JSON.pretty_generate(records)
  when "csv", "tsv"
    delimiter = options[:output] == "tsv" ? "\t" : ","
    $stdout.write(format_delimited_row(fields, delimiter))
    records.each do |r|
      $stdout.write(format_delimited_row(fields.map { |f| extract_display(r[f]) }, delimiter))
    end
  else
    print_table(records, fields, empty_msg: "No matching CMDB items found.")
  end
end

def cmd_cmdb_get(options)
  cfg = load_config(options[:profile])
  ci_class = resolve_cmdb_class(options[:ci_class], default: "cmdb_ci")
  record = resolve_ci_record(cfg, options[:identifier].strip, ci_class)

