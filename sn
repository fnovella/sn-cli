# Minimal RFC 6455 WebSocket client for communicating with local Chromium CDP endpoints.
class CdpClient
  class TimeoutError < StandardError; end

  WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

  def initialize(ws_url, connect_timeout: 5)
    uri = URI.parse(ws_url)
    @seq = 0
    @buf = "".b
    @sock = TCPSocket.new(uri.host, uri.port)
    @sock.setsockopt(Socket::IPPROTO_TCP, Socket::TCP_NODELAY, 1) rescue nil
    handshake(uri, timeout: connect_timeout)
  end

  def call(method, params = {}, timeout: 15)
    @seq += 1
    req_id = @seq
    send_frame(JSON.generate({ "id" => req_id, "method" => method, "params" => params }))

    deadline = Time.now + timeout
    loop do
      remaining = deadline - Time.now
      raise TimeoutError, "CDP call '#{method}' timed out" if remaining <= 0

      raw = recv_frame(timeout: remaining)
      msg = JSON.parse(raw)
      next unless msg["id"] == req_id

      if msg["error"]
        err_msg = msg["error"].is_a?(Hash) ? msg["error"]["message"] : msg["error"].to_s
        raise "CDP #{method} error: #{err_msg}"
      end
      return msg["result"] || {}
    end
  end

  def close
    @sock&.close
  rescue StandardError
    nil
  end

  private

  def handshake(uri, timeout:)
    key = [SecureRandom.random_bytes(16)].pack("m0")
    path = uri.request_uri
    req = "GET #{path} HTTP/1.1\r\n" \
          "Host: #{uri.host}:#{uri.port}\r\n" \
          "Upgrade: websocket\r\n" \
          "Connection: Upgrade\r\n" \
          "Sec-WebSocket-Key: #{key}\r\n" \
          "Sec-WebSocket-Version: 13\r\n\r\n"
    @sock.write(req)

    deadline = Time.now + timeout
    while (idx = @buf.index("\r\n\r\n")).nil?
      remaining = deadline - Time.now
      raise TimeoutError, "Timed out waiting for CDP WebSocket handshake" if remaining <= 0

      fill_buf(remaining)
    end

    raw_headers = @buf.slice!(0, idx + 4)
    lines = raw_headers.split("\r\n")
    status_line = lines.shift
    raise "WebSocket handshake failed: #{status_line.inspect}" unless status_line&.include?("101")

    headers = {}
    lines.each do |line|
      k, v = line.split(":", 2)
      headers[k.strip.downcase] = v.strip if k && v
    end

    expected_accept = [Digest::SHA1.digest("#{key}#{WS_GUID}")].pack("m0")
    if headers["sec-websocket-accept"] && headers["sec-websocket-accept"] != expected_accept
      raise "WebSocket handshake failed: invalid Sec-WebSocket-Accept"
    end
  end

  def fill_buf(timeout)
    if @sock.respond_to?(:timeout=)
      @sock.timeout = timeout
    elsif !@sock.wait_readable(timeout)
      raise TimeoutError, "Timed out waiting for CDP WebSocket"
    end
    @buf << @sock.readpartial(16_384)
  rescue IO::TimeoutError
    raise TimeoutError, "Timed out waiting for CDP WebSocket"
  end

  def read_exact(n, timeout:)
    return "".b if n <= 0

    deadline = Time.now + timeout
    while @buf.bytesize < n
      remaining = deadline - Time.now
      raise TimeoutError, "Timed out reading CDP WebSocket frame" if remaining <= 0

      fill_buf(remaining)
    end
    @buf.slice!(0, n)
  end

  def send_frame(payload, opcode: 0x1)
    bytes = payload.to_s.b
    len = bytes.bytesize
    first_byte = 0x80 | (opcode & 0x0F)
    header = if len < 126
               [first_byte, 0x80 | len].pack("CC")
             elsif len <= 65_535
               [first_byte, 0x80 | 126, len].pack("CCn")
             else
               [first_byte, 0x80 | 127, len].pack("CCQ>")
             end

    mask = SecureRandom.random_bytes(4)
    m = mask.bytes
    masked = bytes.bytes.each_with_index.map { |b, i| b ^ m[i & 3] }.pack("C*")
    @sock.write(header + mask + masked)
  end

  def recv_frame(timeout:)
    fragments = "".b
    loop do
      b1, b2 = read_exact(2, timeout: timeout).unpack("CC")
      fin = (b1 & 0x80) != 0
      opcode = b1 & 0x0F
      masked = (b2 & 0x80) != 0
      len = b2 & 0x7F

      if len == 126
        len = read_exact(2, timeout: timeout).unpack1("n")
      elsif len == 127
        len = read_exact(8, timeout: timeout).unpack1("Q>")
      end

      mask_key = masked ? read_exact(4, timeout: timeout).bytes : nil
      payload = len > 0 ? read_exact(len, timeout: timeout) : "".b

      if masked && len > 0
        payload = payload.bytes.each_with_index.map { |b, i| b ^ mask_key[i & 3] }.pack("C*")
      end

      case opcode
      when 0x8
        begin
          send_frame("", opcode: 0x8)
        rescue StandardError
          nil
        end
        raise EOFError, "CDP WebSocket closed"
      when 0x9
        send_frame(payload, opcode: 0xA)
      when 0xA
        next
      when 0x0, 0x1, 0x2
        fragments << payload
        return fragments.force_encoding("UTF-8") if fin
      end
    end
  end
end

