    rels.each do |rel|
      p_ci = extract_display(rel["parent"])
      t_ci = extract_display(rel["type"])
      c_ci = extract_display(rel["child"])
      puts "  #{p_ci}  #{Colors::YELLOW}[#{t_ci}]#{Colors::RESET}  -->  #{c_ci}"
    end
  end
end

def build_ci_attributes(options)
  attrs = parse_kv_and_json(options[:set], options[:data])
  attrs["name"] = options[:name] if options[:name] && !options[:name].empty?
  attrs["ip_address"] = options[:ip] if options[:ip]
  attrs["serial_number"] = options[:serial] if options[:serial]
  attrs["asset_tag"] = options[:asset_tag] if options[:asset_tag]
  attrs["os"] = options[:os] if options[:os]
  attrs["ram"] = options[:ram].to_s if options[:ram]
  attrs["cpu_count"] = options[:cpu_count].to_s if options[:cpu_count]
  attrs["location"] = options[:location] if options[:location]
  attrs["assigned_to"] = options[:assigned_to] if options[:assigned_to]
  attrs["support_group"] = options[:group] if options[:group]
  attrs["operational_status"] = options[:status].to_s if options[:status]
  attrs["short_description"] = options[:desc] if options[:desc]
  attrs
end

def cmd_cmdb_create(options)
  cfg = load_config(options[:profile])
  ci_class = resolve_cmdb_class(options[:ci_class], default: "cmdb_ci_server")
  attrs = build_ci_attributes(options)

  if attrs["name"].nil? || attrs["name"].to_s.empty?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} CI name is required."
    exit 1
  end

  if options[:ire]
    body = {
      "discovery_source" => options[:source] || "Manual Entry",
      "attributes"       => attrs
    }
    res = sn_request(cfg, "POST", "/api/now/cmdb/instance/#{ci_class}", body: body)
    result_obj = res["result"].is_a?(Hash) ? res["result"] : {}
    record = result_obj["attributes"].is_a?(Hash) ? result_obj["attributes"] : result_obj
  else
    params = { "sysparm_display_value" => "all", "sysparm_input_display_value" => "true" }
    res = sn_request(cfg, "POST", "/api/now/table/#{ci_class}", params: params, body: attrs)
    record = res["result"] || {}
  end

  if options[:json]
    puts JSON.pretty_generate(res["result"] || {})
    return
  end

  name = extract_display(record["name"])
  name = attrs["name"] if name.empty?
  sys_id = extract_raw_value(record["sys_id"])
  puts "#{Colors::GREEN}Created/Reconciled CMDB CI (#{ci_class}):#{Colors::RESET} #{Colors::BOLD}#{name}#{Colors::RESET} (sys_id: #{sys_id})"
  puts "  URL: #{cfg['instance']}/nav_to.do?uri=#{ci_class}.do?sys_id=#{sys_id}" unless sys_id.empty?
end

def cmd_cmdb_update(options)
  cfg = load_config(options[:profile])
  ci_class = resolve_cmdb_class(options[:ci_class], default: "cmdb_ci")
  existing = resolve_ci_record(cfg, options[:identifier].strip, ci_class)
  sys_id = extract_raw_value(existing["sys_id"])
  actual_class = extract_raw_value(existing["sys_class_name"])
  actual_class = ci_class if actual_class.empty?

  attrs = build_ci_attributes(options)
  attrs["name"] = options[:new_name] if options[:new_name]

  if attrs.empty?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} No attributes specified to update."
    exit 1
  end

  params = { "sysparm_display_value" => "all", "sysparm_input_display_value" => "true" }
  res = sn_request(cfg, "PATCH", "/api/now/table/#{actual_class}/#{sys_id}", params: params, body: attrs)
  record = res["result"] || {}

  if options[:json]
    puts JSON.pretty_generate(record)
    return
  end

  name = extract_display(record["name"])
  name = options[:identifier] if name.empty?
  puts "#{Colors::GREEN}Updated CMDB CI:#{Colors::RESET} #{Colors::BOLD}#{name}#{Colors::RESET} (#{actual_class} / #{sys_id})"
end

