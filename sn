  puts "#{Colors::BOLD}Operational Status:#{Colors::RESET} #{op_status}"
  puts "#{Colors::BOLD}Install Status:#{Colors::RESET}     #{inst_status}"
  puts "#{Colors::BOLD}IP Address:#{Colors::RESET}         #{ip}" unless ip.empty?
  puts "#{Colors::BOLD}Serial Number:#{Colors::RESET}      #{serial}" unless serial.empty?
  puts "#{Colors::BOLD}Asset Tag:#{Colors::RESET}          #{asset_tag}" unless asset_tag.empty?
  puts "#{Colors::BOLD}Operating System:#{Colors::RESET}   #{os_val}" unless os_val.empty?
  if !ram.empty? || !cpu.empty?
    cpu_str = cpu.empty? ? "N/A" : cpu
    ram_str = ram.empty? ? "N/A" : ram
    puts "#{Colors::BOLD}Hardware:#{Colors::RESET}           CPU: #{cpu_str} | RAM: #{ram_str} MB"
  end
  puts "#{Colors::BOLD}Assigned To:#{Colors::RESET}        #{assigned_to}" unless assigned_to.empty?
  puts "#{Colors::BOLD}Support Group:#{Colors::RESET}      #{support_group}" unless support_group.empty?
  puts "#{Colors::BOLD}Location:#{Colors::RESET}           #{location}" unless location.empty?
  puts "#{Colors::BOLD}Last Updated:#{Colors::RESET}       #{updated}"
  puts "#{Colors::BOLD}URL:#{Colors::RESET}                #{cfg['instance']}/nav_to.do?uri=#{actual_class}.do?sys_id=#{sys_id}"

  puts "\n#{Colors::BOLD}Description:#{Colors::RESET}\n  #{short_desc}" unless short_desc.empty?

  if options[:relationships] && !sys_id.empty?
    r_params = {
      "sysparm_query"         => "parent=#{sys_id}^ORchild=#{sys_id}",
      "sysparm_fields"        => "parent,type,child",
      "sysparm_display_value" => "true",
      "sysparm_limit"         => "50"
    }
    r_res = sn_request(cfg, "GET", "/api/now/table/cmdb_rel_ci", params: r_params)
    rels = r_res["result"] || []
