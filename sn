              sn list --mine
              sn list -t incident --priority 1

              # Create & Update Incidents / Tickets
              sn create "VPN Down in Madrid" -D "Users cannot connect" --urgency 1 --impact 2 -g "Network"
              sn update INC0010001 --state "In Progress" -a fnovella -w "Investigating firewall"
              sn comment INC0010001 "Issue resolved" --work-note

              # Query, Create & Update CMDB Configuration Items
              sn cmdb list -c linux -s "mad"
