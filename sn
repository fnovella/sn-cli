  puts "#{Colors::BOLD}#{Colors::CYAN}#{name}#{Colors::RESET} — #{Colors::BOLD}#{class_label}#{Colors::RESET}"
  puts "#{Colors::DIM}#{'-' * 72}#{Colors::RESET}"
