def resolve_ci_record(cfg: Dict[str, Any], ident: str, ci_class: str) -> Dict[str, Any]:
    if is_sys_id(ident):
        query = f"sys_id={ident}"
    else:
        query = f"name={ident}^ORserial_number={ident}^ORip_address={ident}^ORasset_tag={ident}"

    params = {
        "sysparm_query": query,
        "sysparm_display_value": "all",
        "sysparm_limit": "1",
    }
    res = sn_request(cfg, "GET", f"/api/now/table/{ci_class}", params=params)
    results = res.get("result", [])
    if not results and ci_class != "cmdb_ci":
        res = sn_request(cfg, "GET", "/api/now/table/cmdb_ci", params=params)
        results = res.get("result", [])
    if not results:
        sys.stderr.write(f"{Colors.RED}CMDB CI '{ident}' not found.{Colors.RESET}\n")
        sys.exit(1)
    return results[0]


def cmd_cmdb_list(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    ci_class = resolve_cmdb_class(args.ci_class, default="cmdb_ci")

    query_parts: List[str] = []
    if args.search:
        s = args.search
        query_parts.append(f"nameLIKE{s}^ORip_addressLIKE{s}^ORserial_numberLIKE{s}^ORasset_tagLIKE{s}")
    if args.ip:
        query_parts.append(f"ip_addressLIKE{args.ip}")
    if args.serial:
        query_parts.append(f"serial_number={args.serial}")
    if args.os:
        query_parts.append(f"osLIKE{args.os}")
    if args.status:
        query_parts.append(f"operational_status={args.status}")
    if args.query:
        query_parts.append(args.query)

    query_parts.append("ORDERBYDESCsys_updated_on")
    final_query = "^".join(query_parts)

    fields = [f.strip() for f in args.fields.split(",") if f.strip()] if args.fields else DEFAULT_CMDB_FIELDS

    params = {
        "sysparm_query": final_query,
        "sysparm_fields": ",".join(fields),
        "sysparm_display_value": "true",
        "sysparm_limit": str(args.limit),
    }

    res = sn_request(cfg, "GET", f"/api/now/table/{ci_class}", params=params)
    records = res.get("result", [])

    if args.output == "json":
        print(json.dumps(records, indent=2))
    elif args.output in ("csv", "tsv"):
        delimiter = "\t" if args.output == "tsv" else ","
        writer = csv.writer(sys.stdout, delimiter=delimiter)
        writer.writerow(fields)
        for r in records:
            writer.writerow([extract_display(r.get(f, "")) for f in fields])
    else:
        print_table(records, fields, empty_msg="No matching CMDB items found.")


def cmd_cmdb_get(args: argparse.Namespace) -> None:
