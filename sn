def build_ci_attributes(args: argparse.Namespace) -> Dict[str, Any]:
    attrs = parse_kv_And_json(args.set, args.data)
    if getattr(args, "name", None):
        attrs["name"] = args.name
    if args.ip:
        attrs["ip_address"] = args.ip
    if args.serial:
        attrs["serial_number"] = args.serial
    if args.asset_tag:
        attrs["asset_tag"] = args.asset_tag
    if args.os:
        attrs["os"] = args.os
    if args.ram:
        attrs["ram"] = str(args.ram)
    if args.cpu_count:
        attrs["cpu_count"] = str(args.cpu_count)
    if args.location:
        attrs["location"] = args.location
    if args.assigned_to:
        attrs["assigned_to"] = args.assigned_to
    if args.group:
        attrs["support_group"] = args.group
    if args.status:
        attrs["operational_status"] = str(args.status)
    if args.desc:
        attrs["short_description"] = args.desc
    return attrs


def cmd_cmdb_create(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    ci_class = resolve_cmdb_class(args.ci_class, default="cmdb_ci_server")
    attrs = build_ci_attributes(args)

    if not attrs.get("name"):
        sys.stderr.write(f"{Colors.RED}Error:{Colors.RESET} CI name is required.\n")
        sys.exit(1)

    if args.ire:
        # Use CMDB Instance API (Identification & Reconciliation Engine)
        body = {
            "discovery_source": args.source or "Manual Entry",
            "attributes": attrs,
        }
        res = sn_request(cfg, "POST", f"/api/now/cmdb/instance/{ci_class}", body=body)
        record = res.get("result", {}).get("attributes", res.get("result", {}))
    else:
        # Direct Table API
        params = {"sysparm_display_value": "all", "sysparm_input_display_value": "true"}
        res = sn_request(cfg, "POST", f"/api/now/table/{ci_class}", params=params, body=attrs)
        record = res.get("result", {})

    if args.json:
        print(json.dumps(res.get("result", {}), indent=2))
        return

    name = extract_display(record.get("name")) or attrs.get("name")
    sys_id = extract_raw_value(record.get("sys_id"))
    print(f"{Colors.GREEN}Created/Reconciled CMDB CI ({ci_class}):{Colors.RESET} {Colors.BOLD}{name}{Colors.RESET} (sys_id: {sys_id})")
    if sys_id:
        print(f"  URL: {cfg['instance']}/nav_to.do?uri={ci_class}.do?sys_id={sys_id}")


def cmd_cmdb_update(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    ci_class = resolve_cmdb_class(args.ci_class, default="cmdb_ci")
    existing = resolve_ci_record(cfg, args.identifier.strip(), ci_class)
    sys_id = extract_raw_value(existing.get("sys_id"))
    actual_class = extract_raw_value(existing.get("sys_class_name")) or ci_class

    attrs = build_ci_attributes(args)
    if args.new_name:
        attrs["name"] = args.new_name

    if not attrs:
        sys.stderr.write(f"{Colors.RED}Error:{Colors.RESET} No attributes specified to update.\n")
        sys.exit(1)

    params = {"sysparm_display_value": "all", "sysparm_input_display_value": "true"}
    res = sn_request(cfg, "PATCH", f"/api/now/table/{actual_class}/{sys_id}", params=params, body=attrs)
    record = res.get("result", {})

    if args.json:
        print(json.dumps(record, indent=2))
        return

    name = extract_display(record.get("name")) or args.identifier
    print(f"{Colors.GREEN}Updated CMDB CI:{Colors.RESET} {Colors.BOLD}{name}{Colors.RESET} ({actual_class} / {sys_id})")


