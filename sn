def cmd_config(args: argparse.Namespace) -> None:
    profile = args.profile
    existing = load_config(profile)

    print(f"{Colors.BOLD}Configuring ServiceNow CLI profile '{profile}'{Colors.RESET}")
    default_inst = existing.get("instance", "")
    inst_input = input(f"Instance name or URL [{default_inst}]: ").strip() or default_inst
    instance = normalize_instance_url(inst_input)
    if not instance:
        print("Instance is required.")
        sys.exit(1)

    default_auth = existing.get("auth_type", "basic")
    auth_type = (
        input(f"Auth method (basic / token / cookie) [{default_auth}]: ").strip().lower()
        or default_auth
    )

    profile_data: Dict[str, Any] = {
        "instance": instance,
        "auth_type": auth_type,
    }

    if auth_type == "token":
        token = getpass.getpass("Bearer / OAuth Token: ").strip() or existing.get("token", "")
        default_user = existing.get("username", "")
        username = input(f"Your ServiceNow username (optional, for --mine) [{default_user}]: ").strip() or default_user
        profile_data["token"] = token
        profile_data["username"] = username
    elif auth_type == "cookie":
        cookie = getpass.getpass("Browser Cookie header string: ").strip() or existing.get("cookie", "")
        user_token = input("X-UserToken (if required, optional): ").strip() or existing.get("user_token", "")
        default_user = existing.get("username", "")
        username = input(f"Your ServiceNow username (optional, for --mine) [{default_user}]: ").strip() or default_user
        profile_data["cookie"] = cookie
        profile_data["user_token"] = user_token
        profile_data["username"] = username
    else:
        default_user = existing.get("username", "")
        username = input(f"Username [{default_user}]: ").strip() or default_user
        password = getpass.getpass("Password (leave blank to keep existing): ") or existing.get("password", "")
        profile_data["username"] = username
        profile_data["password"] = password

    save_config(profile, profile_data)
    print(f"{Colors.GREEN}Saved configuration to {CONFIG_PATH} (permissions 0600).{Colors.RESET}")


def cmd_list(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    table = args.table

    query_parts: List[str] = []
    if not args.all and not args.query:
        query_parts.append("active=true")

    if args.mine:
        user = cfg.get("username")
        if not user:
            sys.stderr.write("Error: username not set in profile for --mine.\n")
            sys.exit(1)
        query_parts.append(f"assigned_to.user_name={user}")

    if args.caller:
        query_parts.append(f"caller_id.user_name={args.caller}^ORopened_by.user_name={args.caller}")

    if args.group:
        query_parts.append(f"assignment_group.nameLIKE{args.group}")

    if args.state:
        query_parts.append(f"state={args.state}")

    if args.priority:
        query_parts.append(f"priority={args.priority}")

    if args.search:
        query_parts.append(f"short_descriptionLIKE{args.search}^ORdescriptionLIKE{args.search}")

    if args.query:
        query_parts.append(args.query)

    order_clause = f"ORDERBYDESC{args.sort}" if args.sort else "ORDERBYDESCsys_updated_on"
    query_parts.append(order_clause)

    final_query = "^".join(query_parts)
    fields = [f.strip() for f in args.fields.split(",") if f.strip()] if args.fields else DEFAULT_TICKET_FIELDS

    params = {
        "sysparm_query": final_query,
        "sysparm_fields": ",".join(fields),
        "sysparm_display_value": "true",
        "sysparm_limit": str(args.limit),
    }

    res = sn_request(cfg, "GET", f"/api/now/table/{table}", params=params)
    records = res.get("result", [])

    if args.output == "json":
        print(json.dumps(records, indent=2))
    elif args.output in ("csv", "tsv"):
        delimiter = "\t" if args.output == "tsv" else ","
        writer = csv.writer(sys.stdout, delimiter=delimiter)
        writer.writerow(fields)
        for r in records:
            writer.writerow([extract_display(r.get(f, "")) for f in fields])
    else:
        print_table(records, fields, empty_msg="No matching tickets found.")


def cmd_get(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    ident = args.ticket.strip()
    table = detect_table(ident, args.table)

    query = f"sys_id={ident}" if is_sys_id(ident) else f"number={ident.upper()}"

    params = {
        "sysparm_query": query,
        "sysparm_display_value": "all",
        "sysparm_limit": "1",
    }

    res = sn_request(cfg, "GET", f"/api/now/table/{table}", params=params)
    results = res.get("result", [])
    if not results and not args.table and table != "task":
        res = sn_request(cfg, "GET", "/api/now/table/task", params=params)
        results = res.get("result", [])

    if not results:
        sys.stderr.write(f"{Colors.RED}Ticket '{ident}' not found.{Colors.RESET}\n")
        sys.exit(1)

    record = results[0]
    if args.json:
        print(json.dumps(record, indent=2))
        return

    num = extract_display(record.get("number")) or ident
    short_desc = extract_display(record.get("short_description"))
    state = extract_display(record.get("state"))
    priority = extract_display(record.get("priority"))
    assigned_to = extract_display(record.get("assigned_to")) or "Unassigned"
    group = extract_display(record.get("assignment_group")) or "None"
    ci = extract_display(record.get("cmdb_ci"))
    caller = (
        extract_display(record.get("caller_id"))
        or extract_display(record.get("requested_for"))
        or extract_display(record.get("opened_by"))
    )
    opened_at = extract_display(record.get("opened_at"))
    updated_on = extract_display(record.get("sys_updated_on"))
    desc = extract_display(record.get("description"))
    close_notes = extract_display(record.get("close_notes"))
    sys_id = extract_raw_value(record.get("sys_id"))

    print(f"{Colors.BOLD}{Colors.CYAN}{num}{Colors.RESET} — {Colors.BOLD}{short_desc}{Colors.RESET}")
    print(f"{Colors.DIM}{'-' * 72}{Colors.RESET}")
    print(f"{Colors.BOLD}Table:{Colors.RESET}            {table} (sys_id: {sys_id})")
    print(f"{Colors.BOLD}State:{Colors.RESET}            {state}")
    print(f"{Colors.BOLD}Priority:{Colors.RESET}         {priority}")
    print(f"{Colors.BOLD}Caller/Opened By:{Colors.RESET} {caller}")
    print(f"{Colors.BOLD}Assignment Group:{Colors.RESET} {group}")
    print(f"{Colors.BOLD}Assigned To:{Colors.RESET}      {assigned_to}")
    if ci:
        print(f"{Colors.BOLD}CMDB CI:{Colors.RESET}          {ci}")
    print(f"{Colors.BOLD}Opened:{Colors.RESET}           {opened_at}")
    print(f"{Colors.BOLD}Last Updated:{Colors.RESET}     {updated_on}")
    print(f"{Colors.BOLD}URL:{Colors.RESET}              {cfg['instance']}/nav_to.do?uri={table}.do?sys_id={sys_id}")

    if desc:
        print(f"\n{Colors.BOLD}Description:{Colors.RESET}")
        print(textwrap.indent(desc.strip(), "  "))

    if close_notes:
        print(f"\n{Colors.BOLD}Close Notes:{Colors.RESET}")
        print(textwrap.indent(close_notes.strip(), "  "))

    if args.comments and sys_id:
        j_params = {
            "sysparm_query": f"element_id={sys_id}^ORDERBYDESCsys_created_on",
            "sysparm_fields": "element,sys_created_on,sys_created_by,value",
            "sysparm_display_value": "true",
            "sysparm_limit": "20",
        }
        j_res = sn_request(cfg, "GET", "/api/now/table/sys_journal_field", params=j_params)
        entries = j_res.get("result", [])
        print(f"\n{Colors.BOLD}Comments & Work Notes ({len(entries)}):{Colors.RESET}")
        for entry in entries:
            el = extract_display(entry.get("element"))
            when = extract_display(entry.get("sys_created_on"))
            who = extract_display(entry.get("sys_created_by"))
            val = extract_display(entry.get("value")).strip()
            tag = "WORK NOTE" if el == "work_notes" else "COMMENT"
            print(f"  {Colors.YELLOW}[{when}] {who} ({tag}):{Colors.RESET}")
            print(textwrap.indent(val, "    "))
            print()


def cmd_create(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    table = args.table

    payload = parse_kv_And_json(args.set, args.data)

    title = args.title or args.short_description
    if title:
        payload["short_description"] = title
    if args.desc:
        payload["description"] = args.desc
    if args.urgency:
        payload["urgency"] = str(args.urgency)
    if args.impact:
        payload["impact"] = str(args.impact)
    if args.priority:
        payload["priority"] = str(args.priority)
    if args.group:
        payload["assignment_group"] = args.group
    if args.assigned_to:
        payload["assigned_to"] = args.assigned_to
    if args.caller:
        payload["caller_id"] = args.caller
    elif cfg.get("username") and "caller_id" not in payload and table == "incident":
        payload["caller_id"] = cfg["username"]
    if args.ci:
        payload["cmdb_ci"] = args.ci
    if args.category:
        payload["category"] = args.category
    if args.subcategory:
        payload["subcategory"] = args.subcategory

    if not payload.get("short_description") and not args.data and not args.set:
        sys.stderr.write(
            f"{Colors.RED}Error:{Colors.RESET} Provide a short description (e.g. 'sn create \"Server down\"') or --data/--set.\n"
        )
        sys.exit(1)

    params = {"sysparm_display_value": "all", "sysparm_input_display_value": "true"}
    res = sn_request(cfg, "POST", f"/api/now/table/{table}", params=params, body=payload)
    record = res.get("result", {})

    if args.json:
        print(json.dumps(record, indent=2))
        return

    num = extract_display(record.get("number"))
    sys_id = extract_raw_value(record.get("sys_id"))
    state = extract_display(record.get("state"))
    priority = extract_display(record.get("priority"))
    print(f"{Colors.GREEN}Created {table} record:{Colors.RESET} {Colors.BOLD}{num or sys_id}{Colors.RESET}")
    if state or priority:
        print(f"  State: {state} | Priority: {priority}")
    print(f"  URL:   {cfg['instance']}/nav_to.do?uri={table}.do?sys_id={sys_id}")


def cmd_update(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    ident = args.ticket.strip()
    table = detect_table(ident, args.table)
    sys_id = resolve_ticket_sys_id(cfg, ident, table)

    payload = parse_kv_And_json(args.set, args.data)

    if args.state:
        payload["state"] = args.state
    if args.title:
        payload["short_description"] = args.title
    if args.desc:
        payload["description"] = args.desc
    if args.urgency:
        payload["urgency"] = str(args.urgency)
    if args.impact:
        payload["impact"] = str(args.impact)
    if args.priority:
        payload["priority"] = str(args.priority)
    if args.group:
        payload["assignment_group"] = args.group
    if args.assigned_to:
        payload["assigned_to"] = args.assigned_to
    if args.ci:
        payload["cmdb_ci"] = args.ci
    if args.comment:
        payload["comments"] = args.comment
    if args.work_note:
        payload["work_notes"] = args.work_note
    if args.close_code:
        payload["close_code"] = args.close_code
    if args.close_notes:
        payload["close_notes"] = args.close_notes

    if not payload:
        sys.stderr.write(f"{Colors.RED}Error:{Colors.RESET} No fields specified to update.\n")
        sys.exit(1)

    params = {"sysparm_display_value": "all", "sysparm_input_display_value": "true"}
    res = sn_request(cfg, "PATCH", f"/api/now/table/{table}/{sys_id}", params=params, body=payload)
    record = res.get("result", {})

    if args.json:
        print(json.dumps(record, indent=2))
        return

    num = extract_display(record.get("number")) or ident.upper()
    state = extract_display(record.get("state"))
    assigned = extract_display(record.get("assigned_to")) or "Unassigned"
    print(f"{Colors.GREEN}Updated {num}:{Colors.RESET} State={state}, Assigned To={assigned}")


def cmd_comment(args: argparse.Namespace) -> None:
    cfg = load_config(args.profile)
    ident = args.ticket.strip()
    table = detect_table(ident, args.table)
    sys_id = resolve_ticket_sys_id(cfg, ident, table)

    field_name = "work_notes" if args.work_note else "comments"
    payload = {field_name: args.message}

    sn_request(cfg, "PATCH", f"/api/now/table/{table}/{sys_id}", body=payload)
    print(f"{Colors.GREEN}Added {field_name} to {ident.upper()}.{Colors.RESET}")


