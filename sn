def cmd_config(options)
  profile = options[:profile]
  existing = load_config(profile)

  puts "#{Colors::BOLD}Configuring ServiceNow CLI profile '#{profile}'#{Colors::RESET}"
  default_inst = existing.fetch("instance", "")
  inst_input = prompt_input("Instance name or URL [#{default_inst}]: ")
  inst_input = default_inst if inst_input.empty?
  instance = normalize_instance_url(inst_input)
  if instance.empty?
    puts "Instance is required."
    exit 1
  end

  default_auth = existing.fetch("auth_type", "basic")
  auth_type = prompt_input("Auth method (basic / token / cookie) [#{default_auth}]: ").downcase
  auth_type = default_auth if auth_type.empty?

  profile_data = {
    "instance"  => instance,
    "auth_type" => auth_type
  }

  case auth_type
  when "token"
    token = prompt_secret("Bearer / OAuth Token: ")
    token = existing.fetch("token", "") if token.empty?
    default_user = existing.fetch("username", "")
    username = prompt_input("Your ServiceNow username (optional, for --mine) [#{default_user}]: ")
    username = default_user if username.empty?
    profile_data["token"] = token
    profile_data["username"] = username
  when "cookie"
    cookie = prompt_secret("Browser Cookie header string: ")
    cookie = existing.fetch("cookie", "") if cookie.empty?
    user_token = prompt_input("X-UserToken (if required, optional): ")
    user_token = existing.fetch("user_token", "") if user_token.empty?
    default_user = existing.fetch("username", "")
    username = prompt_input("Your ServiceNow username (optional, for --mine) [#{default_user}]: ")
    username = default_user if username.empty?
    profile_data["cookie"] = cookie
    profile_data["user_token"] = user_token
    profile_data["username"] = username
  else
    default_user = existing.fetch("username", "")
    username = prompt_input("Username [#{default_user}]: ")
    username = default_user if username.empty?
    password = prompt_secret("Password (leave blank to keep existing): ")
    password = existing.fetch("password", "") if password.empty?
    profile_data["username"] = username
    profile_data["password"] = password
  end

  save_config(profile, profile_data)
  puts "#{Colors::GREEN}Saved configuration to #{CONFIG_PATH} (permissions 0600).#{Colors::RESET}"
end

def cmd_list(options)
  cfg = load_config(options[:profile])
  table = options[:table] || "task"

  query_parts = []
  query_parts << "active=true" if !options[:all] && (options[:query].nil? || options[:query].empty?)

  if options[:mine]
    user = cfg["username"]
    if user.nil? || user.empty?
      $stderr.puts "Error: username not set in profile for --mine."
      exit 1
    end
    query_parts << "assigned_to.user_name=#{user}"
  end

  query_parts << "caller_id.user_name=#{options[:caller]}^ORopened_by.user_name=#{options[:caller]}" if options[:caller]
  query_parts << "assignment_group.nameLIKE#{options[:group]}" if options[:group]
  query_parts << "state=#{options[:state]}" if options[:state]
  query_parts << "priority=#{options[:priority]}" if options[:priority]
  query_parts << "short_descriptionLIKE#{options[:search]}^ORdescriptionLIKE#{options[:search]}" if options[:search]
  query_parts << options[:query] if options[:query] && !options[:query].empty?

  sort_field = options[:sort] && !options[:sort].empty? ? options[:sort] : "sys_updated_on"
  query_parts << "ORDERBYDESC#{sort_field}"

  final_query = query_parts.join("^")
  fields = if options[:fields] && !options[:fields].empty?
             options[:fields].split(",").map(&:strip).reject(&:empty?)
           else
             DEFAULT_TICKET_FIELDS
           end

  params = {
    "sysparm_query"         => final_query,
    "sysparm_fields"        => fields.join(","),
    "sysparm_display_value" => "true",
    "sysparm_limit"         => (options[:limit] || 25).to_s
  }

  res = sn_request(cfg, "GET", "/api/now/table/#{table}", params: params)
  records = res["result"] || []

  case options[:output]
  when "json"
    puts JSON.pretty_generate(records)
  when "csv", "tsv"
    delimiter = options[:output] == "tsv" ? "\t" : ","
    $stdout.write(format_delimited_row(fields, delimiter))
    records.each do |r|
      $stdout.write(format_delimited_row(fields.map { |f| extract_display(r[f]) }, delimiter))
    end
  else
    print_table(records, fields, empty_msg: "No matching tickets found.")
  end
end

def cmd_get(options)
  cfg = load_config(options[:profile])
  ident = options[:ticket].strip
  table = detect_table(ident, options[:table])

  query = sys_id?(ident) ? "sys_id=#{ident}" : "number=#{ident.upcase}"

  params = {
    "sysparm_query"         => query,
    "sysparm_display_value" => "all",
    "sysparm_limit"         => "1"
  }

  res = sn_request(cfg, "GET", "/api/now/table/#{table}", params: params)
  results = res["result"] || []
  if results.empty? && options[:table].nil? && table != "task"
    res = sn_request(cfg, "GET", "/api/now/table/task", params: params)
    results = res["result"] || []
  end

  if results.empty?
    $stderr.puts "#{Colors::RED}Ticket '#{ident}' not found.#{Colors::RESET}"
    exit 1
  end

  record = results[0]
  if options[:json]
    puts JSON.pretty_generate(record)
    return
  end

  num = extract_display(record["number"])
  num = ident if num.empty?
  short_desc = extract_display(record["short_description"])
  state = extract_display(record["state"])
  priority = extract_display(record["priority"])
  assigned_to = extract_display(record["assigned_to"])
  assigned_to = "Unassigned" if assigned_to.empty?
  group = extract_display(record["assignment_group"])
  group = "None" if group.empty?
  ci = extract_display(record["cmdb_ci"])
  caller = [
    extract_display(record["caller_id"]),
    extract_display(record["requested_for"]),
    extract_display(record["opened_by"])
  ].find { |v| !v.empty? }.to_s
  opened_at = extract_display(record["opened_at"])
  updated_on = extract_display(record["sys_updated_on"])
  desc = extract_display(record["description"])
  close_notes = extract_display(record["close_notes"])
  sys_id = extract_raw_value(record["sys_id"])

  puts "#{Colors::BOLD}#{Colors::CYAN}#{num}#{Colors::RESET} — #{Colors::BOLD}#{short_desc}#{Colors::RESET}"
  puts "#{Colors::DIM}#{'-' * 72}#{Colors::RESET}"
  puts "#{Colors::BOLD}Table:#{Colors::RESET}            #{table} (sys_id: #{sys_id})"
  puts "#{Colors::BOLD}State:#{Colors::RESET}            #{state}"
  puts "#{Colors::BOLD}Priority:#{Colors::RESET}         #{priority}"
  puts "#{Colors::BOLD}Caller/Opened By:#{Colors::RESET} #{caller}"
  puts "#{Colors::BOLD}Assignment Group:#{Colors::RESET} #{group}"
  puts "#{Colors::BOLD}Assigned To:#{Colors::RESET}      #{assigned_to}"
  puts "#{Colors::BOLD}CMDB CI:#{Colors::RESET}          #{ci}" unless ci.empty?
  puts "#{Colors::BOLD}Opened:#{Colors::RESET}           #{opened_at}"
  puts "#{Colors::BOLD}Last Updated:#{Colors::RESET}     #{updated_on}"
  puts "#{Colors::BOLD}URL:#{Colors::RESET}              #{cfg['instance']}/nav_to.do?uri=#{table}.do?sys_id=#{sys_id}"

  unless desc.empty?
    puts "\n#{Colors::BOLD}Description:#{Colors::RESET}"
    puts indent_text(desc.strip, "  ")
  end

  unless close_notes.empty?
    puts "\n#{Colors::BOLD}Close Notes:#{Colors::RESET}"
    puts indent_text(close_notes.strip, "  ")
  end

  if options[:comments] && !sys_id.empty?
    j_params = {
      "sysparm_query"         => "element_id=#{sys_id}^ORDERBYDESCsys_created_on",
      "sysparm_fields"        => "element,sys_created_on,sys_created_by,value",
      "sysparm_display_value" => "true",
      "sysparm_limit"         => "20"
    }
    j_res = sn_request(cfg, "GET", "/api/now/table/sys_journal_field", params: j_params)
    entries = j_res["result"] || []
    puts "\n#{Colors::BOLD}Comments & Work Notes (#{entries.length}):#{Colors::RESET}"
    entries.each do |entry|
      el = extract_display(entry["element"])
      when_ts = extract_display(entry["sys_created_on"])
      who = extract_display(entry["sys_created_by"])
      val = extract_display(entry["value"]).strip
      tag = el == "work_notes" ? "WORK NOTE" : "COMMENT"
      puts "  #{Colors::YELLOW}[#{when_ts}] #{who} (#{tag}):#{Colors::RESET}"
      puts indent_text(val, "    ")
      puts
    end
  end
end

def cmd_create(options)
  cfg = load_config(options[:profile])
  table = options[:table] || "incident"

  payload = parse_kv_and_json(options[:set], options[:data])

  title = options[:title] || options[:short_description]
  payload["short_description"] = title if title && !title.empty?
  payload["description"] = options[:desc] if options[:desc]
  payload["urgency"] = options[:urgency].to_s if options[:urgency]
  payload["impact"] = options[:impact].to_s if options[:impact]
  payload["priority"] = options[:priority].to_s if options[:priority]
  payload["assignment_group"] = options[:group] if options[:group]
  payload["assigned_to"] = options[:assigned_to] if options[:assigned_to]
  if options[:caller]
    payload["caller_id"] = options[:caller]
  elsif cfg["username"] && !cfg["username"].empty? && !payload.key?("caller_id") && table == "incident"
    payload["caller_id"] = cfg["username"]
  end
  payload["cmdb_ci"] = options[:ci] if options[:ci]
  payload["category"] = options[:category] if options[:category]
  payload["subcategory"] = options[:subcategory] if options[:subcategory]

  if (payload["short_description"].nil? || payload["short_description"].to_s.empty?) &&
     options[:data].nil? && Array(options[:set]).empty?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} Provide a short description (e.g. 'sn create \"Server down\"') or --data/--set."
    exit 1
  end

  params = { "sysparm_display_value" => "all", "sysparm_input_display_value" => "true" }
  res = sn_request(cfg, "POST", "/api/now/table/#{table}", params: params, body: payload)
  record = res["result"] || {}

  if options[:json]
    puts JSON.pretty_generate(record)
    return
  end

  num = extract_display(record["number"])
  sys_id = extract_raw_value(record["sys_id"])
  state = extract_display(record["state"])
  priority = extract_display(record["priority"])
  label = num.empty? ? sys_id : num
  puts "#{Colors::GREEN}Created #{table} record:#{Colors::RESET} #{Colors::BOLD}#{label}#{Colors::RESET}"
  puts "  State: #{state} | Priority: #{priority}" if !state.empty? || !priority.empty?
  puts "  URL:   #{cfg['instance']}/nav_to.do?uri=#{table}.do?sys_id=#{sys_id}"
end

def cmd_update(options)
  cfg = load_config(options[:profile])
  ident = options[:ticket].strip
  table = detect_table(ident, options[:table])
  sys_id = resolve_ticket_sys_id(cfg, ident, table)

  payload = parse_kv_and_json(options[:set], options[:data])

  payload["state"] = options[:state] if options[:state]
  payload["short_description"] = options[:title] if options[:title]
  payload["description"] = options[:desc] if options[:desc]
  payload["urgency"] = options[:urgency].to_s if options[:urgency]
  payload["impact"] = options[:impact].to_s if options[:impact]
  payload["priority"] = options[:priority].to_s if options[:priority]
  payload["assignment_group"] = options[:group] if options[:group]
  payload["assigned_to"] = options[:assigned_to] if options[:assigned_to]
  payload["cmdb_ci"] = options[:ci] if options[:ci]
  payload["comments"] = options[:comment] if options[:comment]
  payload["work_notes"] = options[:work_note] if options[:work_note]
  payload["close_code"] = options[:close_code] if options[:close_code]
  payload["close_notes"] = options[:close_notes] if options[:close_notes]

  if payload.empty?
    $stderr.puts "#{Colors::RED}Error:#{Colors::RESET} No fields specified to update."
    exit 1
  end

  params = { "sysparm_display_value" => "all", "sysparm_input_display_value" => "true" }
  res = sn_request(cfg, "PATCH", "/api/now/table/#{table}/#{sys_id}", params: params, body: payload)
  record = res["result"] || {}

  if options[:json]
    puts JSON.pretty_generate(record)
    return
  end

  num = extract_display(record["number"])
  num = ident.upcase if num.empty?
  state = extract_display(record["state"])
  assigned = extract_display(record["assigned_to"])
  assigned = "Unassigned" if assigned.empty?
  puts "#{Colors::GREEN}Updated #{num}:#{Colors::RESET} State=#{state}, Assigned To=#{assigned}"
end

def cmd_comment(options)
  cfg = load_config(options[:profile])
  ident = options[:ticket].strip
  table = detect_table(ident, options[:table])
  sys_id = resolve_ticket_sys_id(cfg, ident, table)

