    asset_tag = extract_display(record.get("asset_tag"))
    op_status = extract_display(record.get("operational_status"))
    inst_status = extract_display(record.get("install_status"))
    assigned_to = extract_display(record.get("assigned_to"))
    support_group = extract_display(record.get("support_group"))
    location = extract_display(record.get("location"))
    os_val = extract_display(record.get("os"))
