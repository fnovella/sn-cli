  actual_class = extract_raw_value(record["sys_class_name"])
  actual_class = ci_class if actual_class.empty?
  class_label = extract_display(record["sys_class_name"])
  class_label = actual_class if class_label.empty?
  sys_id = extract_raw_value(record["sys_id"])
  ip = extract_display(record["ip_address"])
  serial = extract_display(record["serial_number"])
  asset_tag = extract_display(record["asset_tag"])
  op_status = extract_display(record["operational_status"])
  inst_status = extract_display(record["install_status"])
  assigned_to = extract_display(record["assigned_to"])
  support_group = extract_display(record["support_group"])
  location = extract_display(record["location"])
  os_val = extract_display(record["os"])
  ram = extract_display(record["ram"])
  cpu = extract_display(record["cpu_count"])
